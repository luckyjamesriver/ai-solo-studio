+  /**
+   * 构造或获取自动化反馈闭环引擎实例
+   */
+  getFeedbackLoop(customMode?: FeedbackLoopMode): AutonomousFeedbackLoop {
+    const thinker =
+      this.o.feedbackLoop?.thinker ??
+      (this.o.makeThinkerByProvider ? this.o.makeThinkerByProvider('codex') : new CodexThinker());
+    return new AutonomousFeedbackLoop({
+      thinker,
+      taskController: {
+        load: (id: string) => this.load(id),
+        reworkTask: (id: unknown, feedback: unknown) => this.reworkTask(id, feedback),
+      },
+      mode: customMode ?? this.o.feedbackLoop?.mode ?? 'autonomous',
+      ...(this.o.feedbackLoop?.maxRetries ? { maxRetries: this.o.feedbackLoop.maxRetries } : {}),
+    });
+  }
+
+  /**
+   * 执行自动评估与反馈纠错闭环：
+   * 分析当前任务产物 -> 失败自动喂给 Thinker 诊断 -> LoopGuard 熔断审查 -> 触发退回修改
+   */
+  async runFeedbackLoop(id: unknown, opts?: { mode?: FeedbackLoopMode }): Promise<FeedbackDiagnosis> {
+    const tid = this.checkArg(TASK_ID, id);
+    await this.ready();
+    const loop = this.getFeedbackLoop(opts?.mode);
+    return loop.processTaskReview(tid);
+  }
