{
  "name": "ai-solo-studio",
  "version": "0.3.0-rebuild",
  "private": true,
  "description": "AI 软件开发与验收工作台：你决定做什么，AI 负责实现，工作台负责证明结果、控制风险、随时可撤销。",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:core": "tsc -p tsconfig.build.json",
    "build:renderer": "vite build",
    "build": "npm run build:core && npm run build:renderer",
    "dev:renderer": "vite",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "try:codex": "npm run build:core && node scripts/try-codex.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
